# ===========================================================================
# Banco de dados (MySQL do WAMP)
# ===========================================================================
# Formato do Prisma. No WAMP o usuario padrao costuma ser root sem senha.
DATABASE_URL="mysql://root:@localhost:3306/nails_agenda"

# Usadas pelo runner de migrations (scripts/migrate.mjs).
# Se preferir, ele tambem sabe ler o DATABASE_URL acima.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD=""
DB_NAME="nails_agenda"

# ===========================================================================
# Servidor
# ===========================================================================
PORT="3333"
HOST="0.0.0.0"
NODE_ENV="development"

# URL publica da API (usada para montar a notification_url do PagBank).
# Em desenvolvimento use um tunel (ngrok/cloudflared) apontando para a API.
PUBLIC_API_URL="http://localhost:3333"

# Endereco do SITE (nao da API). E a base do link que vai na cobranca
# automatica do sinal. Em producao API e site ficam no mesmo dominio,
# entao da para deixar comentado que ele usa o PUBLIC_API_URL.
PUBLIC_WEB_URL="http://localhost:3000"

# Quando sai a cobranca de quem agendou e nao pagou o sinal.
# Precisa ser MENOR que RESERVATION_MINUTES, senao o link ja nasce expirado.
PAYMENT_REMINDER_MINUTES="15"

# ===========================================================================
# Autenticacao (painel admin)
# ===========================================================================
JWT_SECRET="troque-por-uma-chave-bem-grande-e-aleatoria"
JWT_EXPIRES_IN="1d"

# ===========================================================================
# PagBank (PagSeguro) - Orders API / Pix
# ===========================================================================
# WhatsApp: 'manual' (links wa.me) ou 'baileys' (robo automatico).
WHATSAPP_MODE="baileys"

# Anti-bloqueio do robo (modo baileys):
WHATSAPP_DAILY_LIMIT="80"        # max de mensagens automaticas por dia
WHATSAPP_SEND_START_HOUR="8"     # nao envia antes desta hora
WHATSAPP_SEND_END_HOUR="21"      # nao envia depois desta hora
WHATSAPP_MIN_GAP_SEC="25"        # intervalo minimo entre mensagens
WHATSAPP_MAX_GAP_SEC="75"        # intervalo maximo entre mensagens

# Modo de pagamento: 'fake' (teste, simula pagamento) ou 'pagbank' (real).
PAYMENTS_MODE="fake"

# sandbox:    https://sandbox.api.pagseguro.com
# producao:   https://api.pagbank.com
PAGBANK_BASE_URL="https://sandbox.api.pagseguro.com"

# Token de API gerado no painel do PagBank (Bearer).
PAGBANK_TOKEN="seu-token-pagbank-aqui"

# CPF/CNPJ da conta PagBank usado no payload quando a cliente nao informa documento.
PAGBANK_CUSTOMER_TAX_ID=""

# Tempo (em minutos) que o Pix/reserva fica valido antes de expirar.
RESERVATION_MINUTES="30"
